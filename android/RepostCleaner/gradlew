#!/usr/bin/env sh
set -eu
GRADLE_VERSION=8.9
BOOTSTRAP_ROOT="${GRADLE_USER_HOME:-$HOME/.gradle}/repost-cleaner-bootstrap"
GRADLE_HOME="$BOOTSTRAP_ROOT/gradle-$GRADLE_VERSION"
if [ ! -x "$GRADLE_HOME/bin/gradle" ]; then
  mkdir -p "$BOOTSTRAP_ROOT"
  ZIP="${TMPDIR:-/tmp}/gradle-$GRADLE_VERSION-bin.zip"
  SUM="$ZIP.sha256"
  echo "Downloading official Gradle $GRADLE_VERSION distribution..."
  if command -v curl >/dev/null 2>&1; then
    curl -fL "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$ZIP"
    curl -fL "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip.sha256" -o "$SUM"
  elif command -v wget >/dev/null 2>&1; then
    wget "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -O "$ZIP"
    wget "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip.sha256" -O "$SUM"
  else
    echo "curl or wget is required to bootstrap Gradle." >&2
    exit 1
  fi
  EXPECTED="$(tr -d '\r\n ' < "$SUM")"
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s  %s\n' "$EXPECTED" "$ZIP" | sha256sum -c -
  elif command -v shasum >/dev/null 2>&1; then
    printf '%s  %s\n' "$EXPECTED" "$ZIP" | shasum -a 256 -c -
  else
    echo "sha256sum or shasum is required to verify the Gradle download." >&2
    exit 1
  fi
  unzip -oq "$ZIP" -d "$BOOTSTRAP_ROOT"
  rm -f "$ZIP" "$SUM"
fi
exec "$GRADLE_HOME/bin/gradle" "$@"
